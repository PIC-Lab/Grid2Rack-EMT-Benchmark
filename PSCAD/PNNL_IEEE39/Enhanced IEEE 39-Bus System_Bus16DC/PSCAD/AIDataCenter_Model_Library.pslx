      <form name="" w="770" h="725" splitter="75" category-width="180" commentlines="4" help-width="490">
        <category name="Rated Values" visible="true">
          <cond />
          <parameter desc="Rated power,  MVA (Symbol: Sbase)" name="Sbase" group="1.RatedValues" unit="MVA" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1.5]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated L-L, RMS, AC voltage, kV (Symbol: VLL)" name="VLL" group="1.RatedValues" unit="kV" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.48]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC system frequency, Hz (Symbol: freq)" name="freq" group="1.RatedValues" unit="Hz" min="50" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[60 [Hz]]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
        <category name="Control Settings" visible="true">
          <parameter desc="d axis control mode (0: Vdc control; 1: P control ) (Symbol:dmode)" name="dmode" group="2. d-axis current control" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="q axis control mode (0: Q control; 1: VAC control)" name="qmode" group="3.q-axis current control" unit="" min="0" max="3" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <cond />
          <parameter desc="Converter De-block signal (0 : block, 1: de-block)  (Symbol:DBlk)" name="DBlk" group="1. Block" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[DBlk]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Reacitve power ordered,  pu (Symbol:Q_ord_pu)" name="Q_ord_pu" group="3.q-axis current control" unit="pu" min="-1E+38" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Q_ord]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Active Power Order, pu (symbol: Pref_pu)" name="Pref_pu" group="2. d-axis current control" unit="pu" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Pref]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC voltage order, pu ( Symbol: Vac_ord_pu)" name="Vac_ord_pu" group="3.q-axis current control" unit="pu" min="-1E+38" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Vac_ord_pu]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="DC voltage order, kV  (Symbol:Edc_ord)" name="Edc_ord" group="2. d-axis current control" unit="kV" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Edc_ord]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="d or q axis priority: 0-Iq, 1-Id  (Symbol:IlimPriority)" name="ILimPriority" group="4.Current limiter" unit="" min="-2147483648" max="2147483647" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter name="Imax_pu" desc="Maximum rated curret of the converter, pu (Symnol: Imax_pu)" type="Real" group="4.Current limiter" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="-1E+308" max="1E+308">
            <value><![CDATA[1.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="P_RampRate_In" desc="Real Power Increase Ramping Limit (in Normal),pu/s" type="Real" group="2. d-axis current control" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu/s" min="-1E+308" max="1E+308">
            <value><![CDATA[500]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[From Bypass to Normal Converter mode]]></help>
          </parameter>
          <parameter name="P_RampRate_De" desc="Real Power Decrease Ramping Limit(in Normal),pu/s" type="Real" group="2. d-axis current control" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu/s" min="-1E+308" max="1E+308">
            <value><![CDATA[500]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[From Bypass or Normal Converter mode to battery backup mode]]></help>
          </parameter>
          <parameter name="Re_P_RampRate_In" desc="Reconnection Real Power Increase Ramping Limit, pu/s" type="Real" group="2. d-axis current control" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu/s" min="-1E+308" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[From battery backup to Normal Converter]]></help>
          </parameter>
        </category>
      </form>
