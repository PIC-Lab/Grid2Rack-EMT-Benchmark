        <category name="Configuration" visible="true">
          <cond />
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="4">
        <port model="Transfer" name="Comm" x="54" y="0" dim="1" mode="Output" type="Integer" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="Mode" x="-36" y="18" dim="1" mode="Input" type="Real" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="SOC" x="-36" y="-18" dim="1" mode="Input" type="Real" internal="false"><![CDATA[true]]></port>
        <cond><![CDATA[true]]></cond>
        <rect x="-21" y="-32" width="57" height="60" stroke="black" stroke-width="0.2" stroke-dasharray="none" fill-style="Hollow" fill-fg="black" fill-bg="black" />
        <line x1="-36" y1="-18" x2="-21" y2="-18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="-5" y="-16" stroke="black" font-size="small" text-anchor="Middle"><![CDATA[SOC]]></text>
        <line x1="-26" y1="-23" x2="-21" y2="-18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="-26" y1="-13" x2="-21" y2="-18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="-36" y1="18" x2="-21" y2="18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="1" y="21" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[Mode]]></text>
        <line x1="-26" y1="13" x2="-21" y2="18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="-26" y1="23" x2="-21" y2="18" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="54" y1="0" x2="36" y2="0" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="33" y="2" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[]]></text>
      </svg>
      <script>
        <segment name="Fortran" id="485274039" classid="CoreSegment"><![CDATA[	IF (($SOC .GE. 5) .AND. ($SOC .LE. 100)) THEN
        $Comm = 1 ! Charging (Mode=0) or Disharging (Mode=1)are permited according to "Mode"
       
	ELSEIF ($SOC .LT. 5) THEN
        IF ($Mode .EQ. 0) THEN
         $Comm = 0 ! Block Disharging
        ELSE
         $Comm = 1 ! Permit Charging
        ENDIF
	ELSEIF ($SOC .GT. 100) THEN
        IF ($Mode .EQ. 0) THEN
         $Comm = 1 ! Permit Disharging
        ELSE
         $Comm = 0 ! Block Charging
        ENDIF
	ENDIF]]></segment>
        <segment name="Branch" id="334598124" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="838518405" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
