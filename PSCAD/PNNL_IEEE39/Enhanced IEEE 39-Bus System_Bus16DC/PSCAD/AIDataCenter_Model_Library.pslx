      <form name="" splitter="60" w="615" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Configuration" visible="true" splitter="71">
          <parameter name="Vrated" desc="Rated Voltage LL [kV]" type="Real" group="1. Configuration" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="kV" min="-1E+308" max="1E+308">
            <value><![CDATA[0.48]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="fnom" desc="Rated Frequency [Hz]" type="Real" group="1. Configuration" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="Hz" min="-1E+308" max="1E+308">
            <value><![CDATA[60]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Sbase" desc="Rated Capacity [MVA]" type="Real" group="1. Configuration" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="MVA" min="-1E+308" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <cond><![CDATA[true]]></cond>
          <parameter name="InitMode" desc="Initial Mode" type="Choice" group="1. Configuration" helpmode="Append" animate="false">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[0 = Bypass]]></choice>
            <choice><![CDATA[1 = Normal]]></choice>
            <choice><![CDATA[2 = Battery Backup]]></choice>
          </parameter>
          <parameter name="tstart" desc="Activation Simulation Waiting Time (For Initilization)" type="Real" group="1. Configuration" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="-1E+308" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Set a startup time to avoid dection during initialization]]></help>
          </parameter>
          <parameter name="MaxV_Bypass" desc="Bypass Max_voltage [pu]" type="Real" group="Bypass Switch VRT Setting" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="p.u." min="-1E+308" max="1E+308">
            <value><![CDATA[1.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="tdelay_ov_bypass" desc="Bypass Over  Voltage  Holdup time[s]" type="Real" group="Bypass Switch VRT Setting" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="s" min="-1E+308" max="1E+308">
            <value><![CDATA[0.01]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="MinV_Bypass" desc="Bypass Min_Voltage [pu]" type="Real" group="Bypass Switch VRT Setting" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="p.u." min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="tdelay_uv_bypass" desc="Bypass Under Voltage Holdup Time [s]" type="Real" group="Bypass Switch VRT Setting" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="1E+308">
