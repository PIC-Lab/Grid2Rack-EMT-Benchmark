        <text x="33" y="2" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[]]></text>
      </svg>
      <script>
        <segment name="Fortran" id="1069520891" classid="CoreSegment"><![CDATA[	IF (($SOC .GE. 5) .AND. ($SOC .LE. 100)) THEN
        $Comm = 1 ! Charging (Mode=0) or Disharging (Mode=1)are permited according to "Mode"
       
	ELSEIF ($SOC .LT. 5) THEN
        IF ($Mode .EQ. 0) THEN
         $Comm = 0 ! Block Disharging
        ELSE
         $Comm = 1 ! Permit Charging
        ENDIF
	ELSEIF ($SOC .GT. 100) THEN
        IF ($Mode .EQ. 0) THEN
         $Comm = 1 ! Permit Disharging
        ELSE
         $Comm = 0 ! Block Charging
        ENDIF
	ENDIF]]></segment>
        <segment name="Branch" id="343209845" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="407428592" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
