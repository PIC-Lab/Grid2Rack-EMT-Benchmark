        <category name="Rated Values" visible="true">
          <cond />
          <parameter desc="Rated power,  MVA (Symbol: Sbase)" name="Sbase" group="1.RatedValues" unit="MVA" min="0" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated L-L, RMS, AC voltage, kV (Symbol: VLL)" name="VLL" group="1.RatedValues" unit="kV" min="0.05" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.48]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC system frequency, Hz (Symbol: freq)" name="freq" group="1.RatedValues" unit="Hz" min="50" max="1E+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[60 [Hz]]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter name="VDCRated" desc="Rated DC side Voltage [kV](Symbol:VDCRated)" type="Real" group="1.RatedValues" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="0.01" max="1E+308">
            <value><![CDATA[0.9]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Control Settings" visible="true">
          <cond />
          <parameter desc="Converter De-block signal (0 : block, 1: de-block)  (Symbol:DBlk)" name="DBlk" group="1. Control Settings" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[DBlk]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC voltage order, pu ( Symbol: Vac_ord_pu)" name="Vac_ord_pu" group="1. Control Settings" unit="pu" min="-1E+38" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[Vac_ord_pu]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter name="Pset" desc="Power Setpoint(p.u.)" type="Real" group="P-f Droop" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="p.u." min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Dpf" desc="P-f Damping (p.u.)" type="Real" group="P-f Droop" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="p.u." min="1" max="1E+308">
            <value><![CDATA[1000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[delta P=Dpf*delta w]]></help>
          </parameter>
          <parameter name="Qset" desc="Q setpoint(p.u.)" type="Real" group="Q-V Droop" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="p.u." min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Dqv" desc="Q-V Damping" type="Real" group="Q-V Droop" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="p.u." min="1" max="1E+308">
            <value><![CDATA[1000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[delta Q= Dqv* delta V]]></help>
          </parameter>
          <parameter name="Imaxabc" desc="Max current for saturation_abc(Symbol:Imaxabc) [p.u.]" type="Real" group="Current Saturation" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu" min="-1E+308" max="1E+308">
            <value><![CDATA[1.5]]></value>
