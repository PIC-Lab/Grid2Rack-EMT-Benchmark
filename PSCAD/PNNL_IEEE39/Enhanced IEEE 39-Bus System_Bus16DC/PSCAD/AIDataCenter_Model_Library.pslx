    <Definition classid="UserCmpDefn" name="Charge_discharge_2" group="" url="" version="" build="" crc="98607957" instances="0" key="" view="false" date="0" id="2028150622">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
